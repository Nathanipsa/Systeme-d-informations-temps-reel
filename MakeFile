CC = gcc
CFLAGS = -Wall -Wextra -O2 -g -pthread

# Default target: build and run final executable
all: final
	./final

.PHONY: all clean

# Link object files to create executable
final: final.o
	$(CC) $(CFLAGS) -o final final.o

# Compile source files to object files
final.o: final.c
	$(CC) $(CFLAGS) -c final.c

# Clean up compiled files
clean:
	rm -f *.o final
